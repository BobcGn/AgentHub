{
  "name": "agenthub",
  "version": "0.0.0",
  "private": true,
  "description": "Local Intent and Issue proposal review board",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "setup": "node --import tsx src/presentation/setup.ts",
    "dev": "node --import tsx --watch src/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "cli": "node --import tsx src/presentation/cli.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.web.json && tsc --noEmit --project tsconfig.tests.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "build": "tsc --project tsconfig.build.json && vite build --config vite.config.ts",
    "start": "node dist/index.js",
    "test:e2e": "playwright test",
    "records:validate": "node --import tsx src/presentation/validate-records.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "pinyin-pro": "3.29.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
