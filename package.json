{
  "name": "agenthub",
  "version": "0.0.0",
  "private": true,
  "description": "AgentHub TypeScript project scaffold",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "check": "npm run typecheck",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
