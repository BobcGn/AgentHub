{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/records/v1/context-item",
  "title": "Distilled long-term context",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "https://agenthub.local/schemas/records/v1/common#/$defs/id"
    },
    "requirementId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://agenthub.local/schemas/records/v1/common#/$defs/id"
        }
      ]
    },
    "category": {
      "enum": [
        "decision",
        "constraint",
        "open_question",
        "assumption",
        "progress",
        "fact"
      ]
    },
    "content": {
      "$ref": "https://agenthub.local/schemas/records/v1/common#/$defs/text"
    },
    "epistemicStatus": {
      "enum": [
        "confirmed",
        "proposed",
        "unknown",
        "observed"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "$ref": "https://agenthub.local/schemas/records/v1/common#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "https://agenthub.local/schemas/records/v1/common#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "requirementId",
    "category",
    "content",
    "epistemicStatus",
    "sourceRefs",
    "evidenceRefs"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {
            "const": "open_question"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "epistemicStatus": {
            "const": "unknown"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "epistemicStatus": {
            "const": "observed"
          }
        },
        "required": [
          "epistemicStatus"
        ]
      },
      "then": {
        "properties": {
          "evidenceRefs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
